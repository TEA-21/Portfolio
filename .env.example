# OpenRouter API Key for live AI Mascot (ARIA) responses
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: AI Model on OpenRouter (defaults to free tier fallback)
# Examples: google/gemini-2.0-flash-001, deepseek/deepseek-chat, nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Production base URL for metadata, sitemap, and OpenGraph social cards
NEXT_PUBLIC_SITE_URL=https://taanush-portfolio.vercel.app

